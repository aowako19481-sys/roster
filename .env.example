# Copy this file to .env.local and fill in the values. Never commit .env.local.
#
# Both values are public by design (safe in the browser). They come from the
# Supabase TEST project: Project Settings -> API.
# Do NOT put the service-role key or database password in any file.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# TEMPORARY, optional, server-side only (no NEXT_PUBLIC_ prefix): emails that may
# sign in with a password instead of an emailed link. Comma-separated.
# The password itself lives only in Supabase. Remove this to switch it off.
PASSWORD_SIGN_IN_EMAILS=
